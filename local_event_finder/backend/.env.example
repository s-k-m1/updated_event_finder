PORT=5000


DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=event_finder
PGUSER=eventfinder
PGPASSWORD=

JWT_SECRET=

ADMIN_PASSWORD=

# Khalti payment gateway (sandbox)
# Get your test keys from https://test-admin.khalti.com (sign up as a merchant)
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
# Set to false to use the live (production) Khalti environment
KHALTI_SANDBOX=true
# When true (and no secret key set), the backend accepts Khalti callbacks
# without real server-side verification. Useful for demos/presentations only.
KHALTI_DEMO=true

# App URL (used in password reset links)
APP_URL=http://localhost:5173

# SMTP Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
